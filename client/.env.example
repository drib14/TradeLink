# TradeLink Client Environment Variables

# Backend API Base URL
# For local development: http://localhost:3001/api
# For Vercel production: https://<your-render-backend-name>.onrender.com/api
VITE_API_BASE_URL=http://localhost:3001/api

# Backend WebSocket URL
# For local development: http://localhost:3001
# For Vercel production: https://<your-render-backend-name>.onrender.com
VITE_SOCKET_URL=http://localhost:3001
