# TradeLink Client Environment Variables

# Backend API Base URL
# For local development: http://localhost:3001/api
# For Vercel production: https://tradelink-backend.vercel.app/api
VITE_API_BASE_URL=https://tradelink-backend.vercel.app/api

# Backend WebSocket URL (must be a persistent Node.js host; Vercel Functions do not support Socket.IO)
# For local development: http://localhost:3001
# For production: set this to your Render, Railway, or VPS backend origin (no /api suffix)
VITE_SOCKET_URL=https://YOUR-PERSISTENT-BACKEND-HOST

# Admin Moderation Desk Portal URL
# For local development: http://localhost:5174
# For Vercel production: https://tradelink-admin.vercel.app
VITE_ADMIN_URL=https://tradelink-admin.vercel.app

# Student Web App URL
# For local development: http://localhost:5173
# For Vercel production: https://uc-tradelink.vercel.app
VITE_CLIENT_URL=https://uc-tradelink.vercel.app


