# TradeLink Client Environment Variables

# Local development: use the Vite /api proxy (target defaults to http://127.0.0.1:3001).
# Production: configure VITE_API_BASE_URL in the Vercel project settings.
VITE_API_BASE_URL=/api

# Optional local backend override if your Express server uses a different host/port.
# This changes the Vite proxy target; it does not change the browser API URL.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional Socket.IO override. Leave unset locally to use Vite's /socket.io proxy.
# In production, set this to a persistent Node.js host (Render, Railway, or a VPS).
# Vercel Functions do not support persistent Socket.IO connections.
# VITE_SOCKET_URL=https://YOUR-PERSISTENT-BACKEND-HOST

# Admin Moderation Desk Portal URL
# For local development: http://localhost:5174
# For Vercel production: https://tradelink-admin.vercel.app
VITE_ADMIN_URL=https://tradelink-admin.vercel.app

# Student Web App URL
# For local development: http://localhost:5173
# For Vercel production: https://uc-tradelink.vercel.app
VITE_CLIENT_URL=https://uc-tradelink.vercel.app
