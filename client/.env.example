# TradeLink student web app environment
# Copy this file to client/.env. Only public, non-secret VITE_ values belong here.

# Browser requests remain same-origin and are forwarded by Vite to the backend.
VITE_API_BASE_URL=/api

# Optional override. By default, the Vite proxy reads PORT and HOST from server/.env.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional Socket.IO override for a persistent production Node.js backend.
# Leave unset locally to use the Vite /socket.io proxy.
# VITE_SOCKET_URL=https://YOUR-PERSISTENT-BACKEND-HOST

# Public application URLs (not credentials).
VITE_ADMIN_URL=https://tradelink-admin.vercel.app
VITE_CLIENT_URL=https://uc-tradelink.vercel.app
