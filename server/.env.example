# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tradelink_db_test

# Security & JSON Web Tokens (JWT)
JWT_ACCESS_SECRET=tradelink_super_secret_access_jwt_key_2026_uc_main_secure
JWT_REFRESH_SECRET=tradelink_super_secret_refresh_jwt_key_2026_uc_main_secure
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TradeLink UC <notifications@uc.edu.ph>"

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# Cloudflare R2 Object Storage
R2_ENABLED=true
R2_ACCOUNT_ID=your_cloudflare_account_id_hex
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tradelink-media
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GLOBAL_API_KEY=

