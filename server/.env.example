# ============================================================================
# TradeLink Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control — it is .gitignored.
# Generate cryptographic secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================================

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Database Configuration (MySQL 8.0 / Managed Cloud: TiDB, Railway, Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=tradelink_db_test
# For managed cloud DB (e.g., TiDB Cloud, Railway, Aiven):
# DATABASE_URL=mysql://user:password@host:port/database
# DB_SSL=true

# Security & JSON Web Tokens (JWT)
# CRITICAL: Use cryptographically strong random secrets (min 64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_cryptographic_student_access_secret_here
JWT_REFRESH_SECRET=your_cryptographic_student_refresh_secret_here
JWT_ADMIN_ACCESS_SECRET=your_cryptographic_admin_access_secret_here
JWT_ADMIN_REFRESH_SECRET=your_cryptographic_admin_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cryptographic_cookie_secret_here
VERIFICATION_SESSION_SECRET=your_cryptographic_verification_session_secret_here

# CORS Whitelist (Comma-separated list of allowed origins. Do NOT use *)
# Production: set to your Vercel frontend URL (e.g. https://tradelink-uc.vercel.app)
CLIENT_URL=http://localhost:5173,http://localhost:3000
ADMIN_URL=http://localhost:5174
APP_URL=https://tradelink-uc.vercel.app
ADMIN_APP_URL=https://tradelink-admin.vercel.app
ALLOW_VERCEL_PREVIEWS=true

# Cross-Site Cookie Policy (Use 'none' for Render backend + Vercel frontend cross-domain deployment; 'lax' for local)
COOKIE_SAME_SITE=none

# Email Service (Nodemailer via Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="TradeLink UC <noreply@tradelink.app>"

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5
DAILY_UPLOAD_QUOTA_MB=50

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
