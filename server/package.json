{
  "name": "tradelink-server",
  "version": "1.0.0",
  "description": "TradeLink Backend API and Real-Time Server for University of Cebu Marketplace",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:security": "cross-env NODE_ENV=test jest security --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest integration --runInBand",
    "test:perf": "cross-env NODE_ENV=test jest efficiency scalability --runInBand",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed:run": "knex seed:run",
    "seed:clean": "node scripts/clean_seed_live_db.js",
    "security:check": "npm audit --audit-level=high"
  },
  "keywords": [
    "tradelink",
    "marketplace",
    "node",
    "express",
    "mysql",
    "socket.io",
    "jwt",
    "security"
  ],
  "author": "TradeLink Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lru-cache": "^11.5.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "nodemailer": "^6.9.14",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
