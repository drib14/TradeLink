# TradeLink Admin Portal Environment Configuration

# Local development: use the Vite /api proxy (target defaults to http://127.0.0.1:3001).
# Production: configure VITE_API_BASE_URL in the Vercel project settings.
VITE_API_BASE_URL=/api

# Optional local backend override if your Express server uses a different host/port.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Student Web App URL (for returning from admin dashboard)
# For local development: http://localhost:5173
# For production: https://uc-tradelink.vercel.app
VITE_CLIENT_URL=https://uc-tradelink.vercel.app

# Admin Portal URL
# For local development: http://localhost:5174
# For production: https://tradelink-admin.vercel.app
VITE_ADMIN_URL=https://tradelink-admin.vercel.app
